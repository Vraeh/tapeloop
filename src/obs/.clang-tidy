# The checks of the root file, with one more disabled, and why:
# - cppcoreguidelines-pro-type-vararg: libobs logs through blog(), a C variadic
#   function whose arguments the compiler checks against the format string, and the
#   glue has no other way to log. The one snprintf fills an output's error message
#   for libobs and is checked the same way.
InheritParentConfig: true
Checks: -cppcoreguidelines-pro-type-vararg
